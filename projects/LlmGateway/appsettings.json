{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Gateway": {
    "DefaultModel": "qwen3:8b",

    "Providers": [
      {
        "Name": "local",
        "BaseUrl": "http://127.0.0.1:11434/v1",
        "ApiKey": "ollama",
        "Models": [ "qwen3:8b" ]
      },
      {
        "Name": "deepseek",
        "BaseUrl": "https://api.deepseek.com/v1",
        "ApiKey": "",
        "Models": [ "deepseek-flash" ],
        "InputPrice": 2,
        "InputCachePrice": 0.04,
        "OutputPrice": 8,
        "Discount": 0.5,
        "UnDiscountWeek": [ 1, 2, 3, 4, 5 ],
        "UnDiscountTime": [
          { "StartTime": "9:00", "EndTime": "12:00" },
          { "StartTime": "14:00", "EndTime": "18:00" }
        ]
      }
    ],

    "Resilience": {
      "TimeoutSeconds": 55,
      "AttemptTimeoutSeconds": 25,
      "MaxRetryAttempts": 1,
      "RetryDelayMs": 1000,
      "CircuitFailureRatio": 0.5,
      "CircuitMinimumThroughput": 4,
      "CircuitSamplingSeconds": 120,
      "CircuitBreakSeconds": 30
    },

    "Usage": {
      "Enabled": true,
      "DbPath": "data/usage.db"
    }
  }
}
